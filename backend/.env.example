APP_ENV=development
PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=vero_user
DATABASE_PASSWORD=change_me_dev_password
DATABASE_NAME=vero_travel
DATABASE_SSLMODE=disable
DATABASE_URL=postgres://vero_user:change_me_dev_password@localhost:5432/vero_travel?sslmode=disable

JWT_SECRET=super_secret_vero_travel
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=720
JWT_COOKIE_NAME=refresh_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Strict
GUEST_COOKIE_SECURE=false
GUEST_COOKIE_SAME_SITE=Lax
GUEST_SESSION_TTL_HOURS=168
GUEST_IDENTITY_TTL_HOURS=720

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=35
AI_TEMPERATURE=0.4
AI_CONTEXT_RECENT_MESSAGES=8
AI_MEMORY_SUMMARY_AFTER=12
AI_MEMORY_MAX_CHARS=1800
DOKU_CLIENT_ID=
DOKU_SECRET=
N8N_WEBHOOK=

# Google OAuth ("Continue with Google", 18 Agu 2026). Disabled by default.
# Create OAuth credentials in Google Cloud Console and register the redirect URI.
# Placeholders only — NEVER commit real client id/secret here or to VCS.
# App runs fine with these unset: when GOOGLE_OAUTH_ENABLED=false the Google
# endpoints answer 404 and no Google credential is touched (graceful).
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI is canonical; GOOGLE_REDIRECT_URL is an accepted alias
# (URI wins if both are set).
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# GOOGLE_REDIRECT_URL=
GOOGLE_OAUTH_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
# Comma-separated list of trusted reverse proxy CIDRs. Leave empty in dev to
# disable X-Forwarded-For trust (SEC-14). Set real reverse proxy CIDRs in prod.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
